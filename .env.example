# Copy to .env (in this folder) and fill in. Only OPENROUTER_API_KEY is needed for LLM filtering.

# --- LLM filter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
LLM_BATCH_SIZE=150
LLM_WORKERS=4
# 1 lets the model think first: ~4x the output tokens for little change in scores
LLM_REASONING=0

# --- On-chain data (optional; a free tonapi key from https://tonconsole.com makes the
# full crawl ~10x faster: 1000 items/page and parallel workers instead of 100/page) ---
TONAPI_KEY=

# --- Telegram (optional, recommended): one bot from @BotFather powers sign-in with Telegram, the
# Mini App, 2FA approvals, Stars payments and Pro alerts. Without it, password accounts still work.
TELEGRAM_BOT_TOKEN=
# Where people open the app. Must be https:// for the Mini App and the Login Widget (also run
# /setdomain in @BotFather for the widget). On localhost, "Continue with Telegram" still works.
PUBLIC_URL=http://localhost:3000
# Telegram ids made admin on sign-in (comma-separated). The first account is always admin.
ADMIN_TELEGRAM_IDS=
# Only one process may read the bot's updates; set 0 on any extra instance.
BOT_POLL=1

# --- Credits and payments ---
# Free AI credits every account is topped up to each day.
DAILY_CREDITS=100
# TON top-ups go straight to this wallet; each checkout carries its own comment. Empty = TON off.
TON_WALLET=
# Telegram Stars checkout (needs the bot). 0 turns it off.
STARS=1

# --- Proxies (optional) comma-separated http://user:pass@host:port or socks5://host:port.
# Requests rotate across them and the rate limits scale with the count.
PROXIES=

# --- Tuning ---
ADDR=127.0.0.1:8080
DB_PATH=data/fragwatch.db
FRAGMENT_RPS=4
DETAIL_WORKERS=6
PROBE_MIN_SCORE=7
EVERY_AUCTIONS=3m
EVERY_SWEEP=30m
EVERY_CHAIN=12h
EVERY_PROBE=6h
AUTO_JOBS=1
