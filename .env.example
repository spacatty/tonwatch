# The one settings file for TonWatch. Run scripts/setup-env.sh to create .env from this template
# (it generates the database password and asks for the secrets). Keep .env out of git.

# --- LLM filter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
LLM_BATCH_SIZE=150
LLM_WORKERS=4
# 1 lets the model think first: ~4x the output tokens for little change in scores
LLM_REASONING=0

# --- On-chain data (optional; a free tonapi key from https://tonconsole.com makes the
# full crawl ~10x faster: 1000 items/page and parallel workers instead of 100/page) ---
TONAPI_KEY=

# --- Telegram (required): one bot from @BotFather powers sign-in (the only way in), the Mini App,
# Stars payments and Pro alerts.
TELEGRAM_BOT_TOKEN=
# Where people open the app. Must be https:// for the Mini App and the Login Widget (also run
# /setdomain in @BotFather for the widget). On localhost, "Continue with Telegram" still works.
# Behind a reverse proxy this is the proxy's public address, e.g. https://tonwatch.example.com.
PUBLIC_URL=http://localhost:3000
# Telegram ids that are admins (comma-separated). Set this on a public server: when it is empty,
# the first account to sign in becomes admin. Telegram is the only way to sign in.
ADMIN_TELEGRAM_IDS=
# Only one process may read the bot's updates; set 0 on any extra instance.
BOT_POLL=1

# --- Credits and payments ---
# Free AI credits an account can claim each day (it tops the balance up to this), once it has
# paid at least once, and the smaller allowance before that. Nothing is added unless they claim.
DAILY_CREDITS=100
FREE_DAILY_CREDITS=20
# Cloudflare Turnstile keys for the daily claim (dash.cloudflare.com → Turnstile). Empty = the
# claim is a press-and-hold button, which keeps it deliberate but does not stop scripts.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TON top-ups go straight to this wallet; each checkout carries its own comment. Empty = TON off.
TON_WALLET=
# Telegram Stars checkout (needs the bot). 0 turns it off.
STARS=1

# --- Proxies (optional) comma-separated http://user:pass@host:port or socks5://host:port.
# Requests rotate across them and the rate limits scale with the count.
PROXIES=

# --- Database (Postgres; docker compose runs it, nothing outside the stack can reach it) ---
POSTGRES_USER=bidspot
# generated by scripts/setup-env.sh. Postgres takes it only when the volume is first created:
# changing it later needs ALTER USER inside the database too.
POSTGRES_PASSWORD=
POSTGRES_DB=bidspot
# Memory for Postgres: ~25% and ~75% of what the host can spare for it.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
# For `go run` against the dev compose file (docker-compose.dev.yml publishes the database on
# 127.0.0.1:DB_PORT). In Docker the backend connects on its own network and ignores this.
DB_PORT=5432
DATABASE_URL=

# --- Docker (docker compose up -d --build) ---
# Only the dashboard is published, on BIND_IP:WEB_PORT. Keep 127.0.0.1 and let the reverse proxy
# for your domain pass to http://127.0.0.1:WEB_PORT (it serves the pages and /api).
BIND_IP=127.0.0.1
WEB_PORT=3000

# --- Tuning ---
# ADDR applies to `go run`; in Docker the container sets its own.
ADDR=127.0.0.1:8080
FRAGMENT_RPS=4
DETAIL_WORKERS=6
PROBE_MIN_SCORE=7
EVERY_AUCTIONS=3m
EVERY_SWEEP=30m
EVERY_CHAIN=12h
EVERY_PROBE=6h
AUTO_JOBS=1
# true stops the tonapi chain crawl and listing prices (e.g. on a dev machine, to save the API
# quota). Fragment auctions and sales keep updating.
SKIP_CHAIN=
